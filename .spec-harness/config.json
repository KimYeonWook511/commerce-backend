{
  "rule_docs": [
    "docs/spec-constitution.md",
    "docs/package-structure-conventions.md",
    "docs/exception-strategy.md",
    "docs/optimistic-lock-design.md",
    "docs/persistence-conventions.md",
    "docs/test-code-conventions.md",
    "docs/logging-conventions.md"
  ],
  "commit_rule_docs": ["docs/commit-conventions.md"],
