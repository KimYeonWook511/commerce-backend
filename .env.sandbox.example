# ---------- NaverPay Sandbox ----------
# 인증값: https://developers.pay.naver.com/user/merchant/auth
LOCAL_NAVERPAY_CLIENT_ID=
LOCAL_NAVERPAY_CLIENT_SECRET=
LOCAL_NAVERPAY_CHAIN_ID=

# 결제 완료 후 콜백 URL
LOCAL_NAVERPAY_RETURN_URL=
# 단건 결제 승인 API URL
LOCAL_NAVERPAY_APPROVAL_URL=
# 단건 결제 취소 API URL
LOCAL_NAVERPAY_CANCEL_URL=
# 결제 내역 조회 API URL — 결제번호 자리를 {paymentId}로 남겨 둔다
# 예: https://dev-pay.paygate.naver.com/naverpay-partner/naverpay/payments/v2.3/list/history/{paymentId}
LOCAL_NAVERPAY_PAYMENT_HISTORY_URL=

# 이력 조회 sandbox 테스트에 쓸 결제 번호. 승인과 환불을 이미 태운 결제라야 이력에 항목이 있다.
# 아래 시나리오 확인을 한 번 돌리고 그 번호를 여기로 옮겨 적으면 된다.
# 샌드박스 결제 데이터는 7일 뒤 사라지므로 그때가 되면 다시 만든다
LOCAL_NAVERPAY_HISTORY_PAYMENT_ID=

# 승인부터 잔액 환불까지 실제로 태우는 확인. 돈을 움직이고 결제 번호를 소모하므로 켤 때만 돈다
LOCAL_NAVERPAY_ENABLE_LIFECYCLE=false
# 그 확인에 쓸 결제 번호. 결제창 인증을 갓 마쳐 아직 승인 전인 번호라야 한다.
# 인증 후 10분 안에 승인을 보내야 하므로 받자마자 채우고 바로 돌린다
LOCAL_NAVERPAY_LIFECYCLE_PAYMENT_ID=
