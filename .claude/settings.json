{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use_policy.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "spec-harness@KimYeonWook511-harness": true
  },
  "extraKnownMarketplaces": {
    "KimYeonWook511-harness": {
      "source": {
        "source": "github",
        "repo": "KimYeonWook511/spec-harness-plugin"
      }
    }
  }
}
